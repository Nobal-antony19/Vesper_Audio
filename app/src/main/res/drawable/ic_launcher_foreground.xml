<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vesper Crescent Moon -->
    <path
        android:pathData="M 64,26 C 41,26 27,38 27,54 C 27,70 41,82 64,82 C 55,77 47,67 47,54 C 47,41 55,31 64,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="27"
                android:startY="26"
                android:endX="64"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF1D5" />
                <item android:offset="0.5" android:color="#E8B07A" />
                <item android:offset="1.0" android:color="#722C42" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Waveform Bar 1 (Leftmost small bar) -->
    <path
        android:pathData="M 50,51 L 50,57"
        android:strokeWidth="2.8"
        android:strokeColor="#722C42"
        android:strokeLineCap="round" />

    <!-- Waveform Bar 2 (Medium) -->
    <path
        android:pathData="M 55,44 L 55,64"
        android:strokeWidth="3.0"
        android:strokeColor="#A84462"
        android:strokeLineCap="round" />

    <!-- Waveform Bar 3 (Center High Bar with Luminous Gradient) -->
    <path
        android:pathData="M 61,37 L 61,71"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="61"
                android:startY="37"
                android:endX="61"
                android:endY="71"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF1D5" />
                <item android:offset="0.5" android:color="#F5E7CC" />
                <item android:offset="1.0" android:color="#722C42" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Waveform Bar 4 (Secondary High Bar) -->
    <path
        android:pathData="M 67,43 L 67,65"
        android:strokeWidth="3.0"
        android:strokeColor="#D4869C"
        android:strokeLineCap="round" />

    <!-- Waveform Bar 5 (Medium-Low) -->
    <path
        android:pathData="M 72,48 L 72,60"
        android:strokeWidth="2.8"
        android:strokeColor="#722C42"
        android:strokeLineCap="round" />

    <!-- Dot Pulse 6 -->
    <path
        android:pathData="M 77,54 L 77,54.1"
        android:strokeWidth="2.8"
        android:strokeColor="#FFF1D5"
        android:strokeLineCap="round" />

    <!-- 4-pointed Star at Top Right -->
    <path
        android:pathData="M 70,22 Q 70,26 66,26 Q 70,26 70,30 Q 70,26 74,26 Q 70,26 70,22 Z"
        android:fillColor="#FFF1D5" />
</vector>
